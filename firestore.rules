rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    
    // === HELPER FUNCTIONS ===
    function isAuthed()       { return request.auth != null; }
    function tenant(t)        { return isAuthed() && request.auth.token.tenant_id == t; }
    function isManager()      { return isAuthed() && request.auth.token.role == 'manager'; }
    function isVerifier()     { return isAuthed() && request.auth.token.role == 'verifier'; }
    function isUploader()     { return isAuthed() && request.auth.token.role == 'uploader'; }
    function inCompany(c)     { return isAuthed() && request.auth.token.company_ids != null
                                     && request.auth.token.company_ids.hasAny([c]); }
    
    // === DOCUMENTS: SOLO LETTURA (scrittura via backend) ===
    match /tenants/{tid}/companies/{cid}/documents/{docId} {
      allow read:  if tenant(tid) && (inCompany(cid) || isVerifier() || isManager());
      allow write: if false; // Solo backend (Admin SDK bypassa rules)
    }
    
    // === REQUESTS: lettura tenant, create da utenti autorizzati ===
    match /tenants/{tid}/companies/{cid}/requests/{rid} {
      allow read:   if tenant(tid) && (inCompany(cid) || isVerifier() || isManager());
      allow create: if tenant(tid) && (inCompany(cid) || isVerifier() || isManager());
      allow update, delete: if tenant(tid) && (isVerifier() || isManager());
    }
    
    // === COMPANIES (aggregati): SOLO LETTURA ===
    match /tenants/{tid}/companies/{cid} {
      allow read:  if tenant(tid) && (inCompany(cid) || isVerifier() || isManager());
      allow write: if false; // Solo backend
    }
    
    // === KB CHUNKS: lettura tenant, scrittura manager ===
    match /tenants/{tid}/kb_chunks/{chunkId} {
      allow read: if tenant(tid);
      allow create, update, delete: if tenant(tid) && isManager();
    }
    
    // === NOTIFICHE IN-APP ===
    match /tenants/{tid}/notifications/{nid} {
      allow read: if tenant(tid) && (isVerifier() || isManager() || inCompany(resource.data.companyId));
      allow write: if false; // Solo backend
    }
    
    // === USER READS (stato lettura notifiche) ===
    match /tenants/{tid}/userReads/{uid}/reads/{nid} {
      allow read, write: if tenant(tid) && request.auth.uid == uid;
    }
    
    // === MAIL COLLECTION (Firebase Extension): nessun accesso client ===
    match /mail/{mid} {
      allow read, write: if false; // Solo Extension/backend
    }
    
    // === INVITES (gestiti da manager) ===
    match /tenants/{tid}/invites/{iid} {
      allow read, create, update, delete: if tenant(tid) && isManager();
    }
  }
}
