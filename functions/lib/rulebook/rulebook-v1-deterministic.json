    "deterministicRules": {
        "DURC": [
            {
                "ruleId": "durc_validity_120d",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "age_days_lte",
                "value": 120,
                "unit": "days",
                "policy": false,
                "source": "DURC_excerpt"
            },
            {
                "ruleId": "durc_protocol_present",
                "evaluation": "det",
                "field": "protocolNumber",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "durc_emitter_present",
                "evaluation": "det",
                "field": "emitter",
                "op": "present",
                "value": true
            }
        ],
        "VISURA": [
            {
                "ruleId": "visura_validity_180d",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "age_days_lte",
                "value": 180,
                "unit": "days",
                "policy": true,
                "source": "policy_azienda"
            },
            {
                "ruleId": "piva_format",
                "evaluation": "det",
                "field": "piva",
                "op": "regex",
                "value": "^\\d{11}$"
            },
            {
                "ruleId": "cf_format",
                "evaluation": "det",
                "field": "cf",
                "op": "regex",
                "value": "^[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]$"
            }
        ],
        "PREPOSTO": [
            {
                "ruleId": "preposti_hours_min",
                "evaluation": "det",
                "field": "hours",
                "op": "gte",
                "value": 12,
                "unit": "h",
                "extra": {
                    "when": {
                        "field": "issuedAt",
                        "op": "date_gt_param",
                        "param": "PREPOSTI_CUTOFF"
                    }
                }
            },
            {
                "ruleId": "preposti_transition_hours",
                "evaluation": "det",
                "field": "hours",
                "op": "gte",
                "value": 8,
                "unit": "h",
                "extra": {
                    "when": {
                        "field": "issuedAt",
                        "op": "date_lte_param",
                        "param": "PREPOSTI_CUTOFF"
                    }
                }
            },
            {
                "ruleId": "preposti_update_2y",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "age_months_lte",
                "value": 24
            },
            {
                "ruleId": "issuedAt_present",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "holder_present",
                "evaluation": "det",
                "field": "holder",
                "op": "present",
                "value": true
            }
        ],
        "LAVORATORE": [
            {
                "ruleId": "hours_min_by_risk",
                "evaluation": "det",
                "field": "hours",
