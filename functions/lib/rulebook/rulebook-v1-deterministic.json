{
    "schemaVersion": "1.1",
    "lastUpdated": "2025-11-19",
    "metadata": {
        "source": "Dev specifications + committente requirements",
        "description": "Rulebook v1.1 - Aggiunge regole deterministiche per backend engine"
    },
    "deterministicRules": {
        "DURC": [
            {
                "ruleId": "durc_validity_120d",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "age_days_lte",
                "value": 120,
                "unit": "days",
                "policy": false,
                "source": "DURC_excerpt"
            },
            {
                "ruleId": "durc_protocol_present",
                "evaluation": "det",
                "field": "protocolNumber",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "durc_emitter_present",
                "evaluation": "det",
                "field": "emitter",
                "op": "present",
                "value": true
            }
        ],
        "VISURA": [
            {
                "ruleId": "visura_validity_180d",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "age_days_lte",
                "value": 180,
                "unit": "days",
                "policy": true,
                "source": "policy_azienda"
            },
            {
                "ruleId": "piva_format",
                "evaluation": "det",
                "field": "piva",
                "op": "regex",
                "value": "^\\d{11}$"
            },
            {
                "ruleId": "cf_format",
                "evaluation": "det",
                "field": "cf",
                "op": "regex",
                "value": "^[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]$"
            }
        ],
        "PREPOSTO": [
            {
                "ruleId": "preposti_hours_min",
                "evaluation": "det",
                "field": "hours",
                "op": "gte",
                "value": 12,
                "unit": "h"
            },
            {
                "ruleId": "preposti_transition_hours",
                "evaluation": "det",
                "field": "hours",
                "op": "gte_if_date_le",
                "value": 8,
                "dateField": "issuedAt",
                "dateCutoffParam": "PREPOSTI_CUTOFF"
            },
            {
                "ruleId": "preposti_update_2y",
                "evaluation": "det",
                "field": "lastTraining",
                "op": "age_months_lte",
                "value": 24
            },
            {
                "ruleId": "issuedAt_present",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "holder_present",
                "evaluation": "det",
                "field": "holder",
                "op": "present",
                "value": true
            }
        ],
        "LAVORATORE": [
            {
                "ruleId": "hours_min_by_risk",
                "evaluation": "det",
                "field": "totalHours",
                "op": "gte_by_risk",
                "value": {
                    "low": 8,
                    "medium": 12,
                    "high": 16
                }
            },
            {
                "ruleId": "update_quinquennale",
                "evaluation": "det",
                "field": "lastTraining",
                "op": "age_months_lte",
                "value": 60,
                "extra": {
                    "updateHoursField": "updateHours",
                    "updateHoursMin": 6
                }
            },
            {
                "ruleId": "issuedAt_present",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "holder_present",
                "evaluation": "det",
                "field": "holder",
                "op": "present",
                "value": true
            }
        ],
        "DVR": [
            {
                "ruleId": "dvr_presence",
                "evaluation": "det",
                "field": "exists",
                "op": "eq",
                "value": true
            },
            {
                "ruleId": "dvr_update_policy",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "age_months_lte",
                "value": 12,
                "policy": true
            }
        ],
        "POS": [
            {
                "ruleId": "pos_presence",
                "evaluation": "det",
                "field": "exists",
                "op": "eq",
                "value": true
            },
            {
                "ruleId": "pos_site_match",
                "evaluation": "det",
                "field": "site",
                "op": "equals",
                "valueParam": "targetSite"
            },
            {
                "ruleId": "issuedAt_present",
                "evaluation": "det",
                "field": "issuedAt",
                "op": "present",
                "value": true
            }
        ],
        "REGISTRO_ANTINCENDIO": [
            {
                "ruleId": "antincendio_register_presence",
                "evaluation": "det",
                "field": "exists",
                "op": "eq",
                "value": true
            },
            {
                "ruleId": "antincendio_entry_recent",
                "evaluation": "det",
                "field": "lastEntry",
                "op": "age_months_lte",
                "value": 6,
                "policy": true
            },
            {
                "ruleId": "antincendio_maintainer_marker",
                "evaluation": "det_or_llm",
                "field": "maintainerQualifiedMarker",
                "op": "contains_any",
                "value": [
                    "tecnico manutentore qualificato",
                    "qualificazione manutentore",
                    "UNI"
                ]
            }
        ],
        "UNILAV": [
            {
                "ruleId": "unilav_emitter_present",
                "evaluation": "det",
                "field": "emitter",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "unilav_contract_type_present",
                "evaluation": "det",
                "field": "contractType",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "unilav_contract_type_allowed",
                "evaluation": "det",
                "field": "contractType",
                "op": "regex",
                "value": "^(indeterminato|determinato|apprendistato professionalizzante|co\\.co\\.co|distacco comando)$"
            },
            {
                "ruleId": "unilav_end_date_present_if_term",
                "evaluation": "det",
                "field": "contractEndDate",
                "op": "present",
                "value": true,
                "extra": {
                    "when": {
                        "field": "contractType",
                        "op": "regex",
                        "value": "^(determinato|apprendistato professionalizzante|co\\.co\\.co|distacco comando)$"
                    }
                }
            },
            {
                "ruleId": "unilav_contract_not_expired",
                "evaluation": "det",
                "field": "contractEndDate",
                "op": "date_gte_today",
                "extra": {
                    "when": {
                        "field": "contractType",
                        "op": "regex",
                        "value": "^(determinato|apprendistato professionalizzante|co\\.co\\.co|distacco comando)$"
                    }
                }
            },
            {
                "ruleId": "unilav_distaccataria_present_if_distacco",
                "evaluation": "det",
                "field": "distaccatariaName",
                "op": "present",
                "value": true,
                "extra": {
                    "when": {
                        "field": "contractType",
                        "op": "equals",
                        "value": "distacco comando"
                    }
                }
            }
        ],
        "LETTERA_DISTACCO": [
            {
                "ruleId": "lettera_distacco_presence",
                "evaluation": "det",
                "field": "exists",
                "op": "eq",
                "value": true
            },
            {
                "ruleId": "lettera_distacco_start_present",
                "evaluation": "det",
                "field": "contractStartDate",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "lettera_distacco_end_present",
                "evaluation": "det",
                "field": "contractEndDate",
                "op": "present",
                "value": true
            },
            {
                "ruleId": "lettera_distacco_not_expired",
                "evaluation": "det",
                "field": "contractEndDate",
                "op": "date_gte_today"
            }
        ],
